# ==============================================================================
# 🧪 DEEPEVAL & CONFIDENT AI CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env or test/.env and fill in your values:
#   cp test/.env.example test/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Confident AI (Optional Platform Dashboard & Telemetry)
# ------------------------------------------------------------------------------
# Get your API key from https://app.confident-ai.com
CONFIDENT_API_KEY=your-confident-ai-api-key-here
DEEPEVAL_CONFIDENT_REGION=US

# ------------------------------------------------------------------------------
# 2. DeepEval Core Engine & Logging Flags
# ------------------------------------------------------------------------------
DEEPEVAL_TELEMETRY_OPT_OUT=NO
DEEPEVAL_VERBOSE_MODE=YES
DEEPEVAL_METRIC_VERBOSE=YES
SKIP_DEEPEVAL_MISSING_PARAMS=NO

# ------------------------------------------------------------------------------
# 3. LLM Judge / Evaluator Configuration (OpenAI - Default)
# ------------------------------------------------------------------------------
USE_OPENAI_MODEL=YES
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL_NAME=gpt-4o-mini
# OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_EMBEDDING_MODEL_NAME=text-embedding-3-small

# ------------------------------------------------------------------------------
# 4. Alternative LLM Providers (Optional)
# ------------------------------------------------------------------------------
# USE_GEMINI_MODEL=YES
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL_NAME=gemini-1.5-flash

# USE_ANTHROPIC_MODEL=YES
# ANTHROPIC_API_KEY=your-anthropic-api-key
# ANTHROPIC_MODEL_NAME=claude-3-5-sonnet-20241022

# USE_LOCAL_MODEL=YES
# LOCAL_MODEL_NAME=qwen2.5-7b-instruct
# LOCAL_MODEL_BASE_URL=http://localhost:1234/v1

# ------------------------------------------------------------------------------
# 5. RAG Pipeline & Database Integration (For End-to-End Tests)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
PSS_API_URL=http://localhost:8000/api/pss

AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=amzn-souranj-rag-docs-prod-789303374640-us-east-1-an

# ------------------------------------------------------------------------------
# 6. Observability & Tracing (LangSmith)
# ------------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=rag-chatbot-eval

